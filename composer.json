{
    "name": "salesforce-mc/fuel-sdk-php",
    "description": "PHP 8-compatible community fork of the Salesforce Marketing Cloud Fuel SDK",
    "homepage": "https://github.com/rodruiz/FuelSDK-PHP",
    "license": "MIT",
    "type": "library",
    "minimum-stability": "stable",
    "require": {
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-soap": "*",
        "php": "^8.1",
        "robrichards/wse-php": "^2.0.4",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^12.0"
    },
    "support": {
        "issues": "https://github.com/rodruiz/FuelSDK-PHP/issues",
        "source": "https://github.com/rodruiz/FuelSDK-PHP/tree/php8"
    },
    "keywords": [
        "exacttarget",
        "salesforce",
        "marketing cloud",
        "php sdk",
        "sdk",
        "fuel sdk",
        "fuel-sdk"
    ],
    "autoload": {
        "psr-4": {
            "FuelSdk\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FuelSdk\\Test\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@format:check",
            "@test"
        ],
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "test": "phpunit -c tests/phpunit.xml"
    }
}
